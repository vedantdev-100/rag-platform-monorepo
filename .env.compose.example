# Copy to .env.compose at the repository root. Fill in your existing credentials.
# These are examples for Docker Desktop on Windows; retain your actual ports/DB names.
# Copy each CURRENT WORKING DATABASE_URL and replace its host with host.docker.internal.
# Preserve any parameters required by your current auth DB session implementation.
AUTH_DATABASE_URL=postgresql+asyncpg://auth_service_role:CHANGE_ME@host.docker.internal:5431/ai_platform
RAG_DATABASE_URL=postgresql+asyncpg://rag_service_role:CHANGE_ME@host.docker.internal:5431/ai_platform
# Preserve each Redis URL's database number, credentials and stream name.
# If your deployments already use different Redis databases, keep them different here.
AUTH_REDIS_URL=redis://host.docker.internal:6379/0
EVENTS_REDIS_URL=redis://host.docker.internal:6379/0
USER_EVENTS_STREAM=user-events
USER_EVENTS_CONSUMER_GROUP=rag-service
AUTH_HOST_PORT=8001
RAG_HOST_PORT=8000
