# Copy to repository root as .env.evals. This file is read ONLY by run.py.
EVAL_RAG_BASE_URL=http://127.0.0.1:8000
EVAL_JUDGE_BASE_URL=http://127.0.0.1:1234/v1
EVAL_JUDGE_MODEL=REPLACE_WITH_EXACT_ID_FROM_V1_MODELS
# Record model hash, quantization and LM Studio version. This identifies cached scores.
EVAL_JUDGE_REVISION=REPLACE_WITH_MODEL_HASH_QUANTIZATION_AND_RUNTIME_VERSION
EVAL_JUDGE_API_KEY=
EVAL_JUDGE_TEMPERATURE=0
EVAL_JUDGE_TIMEOUT_SECONDS=180
EVAL_JUDGE_MAX_OUTPUT_TOKENS=4096
# Byte limit is a conservative guard, not an exact token counter.
# Verify the model's configured context can hold the input plus output budget.
EVAL_JUDGE_MAX_INPUT_BYTES=50000
EVAL_CACHE_DIR=evals/step15/results/judge-cache
# Increase to respect your actual hosted provider and API rate limits.
EVAL_GENERATION_INTERVAL_SECONDS=15
EVAL_CAPTURE_TIMEOUT_SECONDS=420
EVAL_POLL_SECONDS=5
EVAL_INGEST_TIMEOUT_SECONDS=1800
